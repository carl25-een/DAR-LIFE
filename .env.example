# DAR LIFE — environment variables (example only, no real values here).
#
# Copy this file to `.env.local` and fill in the two values from your
# Supabase project: Supabase dashboard → your project → Settings → API.
# `.env.local` is gitignored and must never be committed or shared.
# The same two values must also be added in Vercel (Project → Settings →
# Environment Variables) for the live site.

# Your Supabase project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase "anon public" key (safe to expose in the browser — Row
# Level Security in supabase/schema.sql is what protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
